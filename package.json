{
  "name": "coffees-pos",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port 3000 --host",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "electron . --dev",
    "dist:mac": "vite build && electron-builder --mac",
    "dist:win": "vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --x64",
    "dist:all": "vite build && electron-builder -mw"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "description": "Coffee´s Pos",
  "author": "Coffee´s Pos",
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.1"
  },
  "build": {
    "appId": "com.coffeespos.desktop",
    "productName": "Coffee´s Pos",
    "copyright": "Copyright © 2026 Coffee´s Pos",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "identity": null,
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Coffee´s Pos"
    }
  }
}
